{
  "//": "TraitPilot 配置模板。复制为 config.json 后按需修改；config.json 已被 .gitignore 忽略。",
  "//优先级": "CLI 参数 > 环境变量 > config.json > 代码默认值。ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN 会覆盖下面的 base_url / api_key。",
  "//用法": "内置功能默认开启。将某项设为 false 可关闭；已存在的配置值继续生效。",

  "base_url": "https://api.anthropic.com",
  "api_key": "",
  "model": "claude-opus-4-5",
  "permission": "auto",
  "skills_dir": "skills",
  "cwd": "",

  "//可选功能": "—— 内置能力默认开启；以下开关可单独关闭 ——",

  "retrieval": true,
  "todo": true,
  "memory": true,
  "error_learning": true,
  "summary_compaction": true,
  "persist": true,
  "parallel_tools": true,
  "prompt_cache": true,
  "loop_guard": true,
  "idempotency": true,
  "restrict_paths": true,
  "write_approval": true,
  "trace": true,
  "spill": true,

  "//permission_roots": "Read/Write/Edit 等工具需要访问仓库之外的数据时，将数据的绝对路径加到此数组。",
  "permission_roots": [],

  "//sandbox": "host 可直接调用宿主机 Conda 工具；rlimit/docker 根据机器环境选择。",
  "sandbox": "host",
  "sandbox_strict": false,
  "sandbox_spec": {},

  "fallback_models": [],

  "//调参": "—— 需要时再填；留空/省略即默认 ——",
  "max_tokens": 8192,
  "max_turns": null,
  "max_seconds": null,
  "max_output_tokens": null,
  "spill_threshold": 30000,
  "index_dir": "",
  "retrieval_roots": [],
  "retrieval_excludes": [],
  "idempotency_mode": "reuse",
  "plugin_dirs": [],

  "//env": "—— 技能数据路径（可选）——",
  "//env说明": "技能/脚本读取的环境变量；在此设置 = 无需 export。真实环境变量优先于本块。",
  "env": {
    "GENO_DIR": "",
    "IMAGE_DIR": "",
    "PIPELINE_DB": "",
    "FAM_PATH": "",
    "NIR_XLS": "",
    "CORR_XLS": ""
  }
}
