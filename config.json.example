{
  "//": "SkillAgent 配置模板。复制为 config.json 后按需修改；config.json 已被 .gitignore 忽略。",
  "//优先级": "环境变量 > config.json > 代码默认值。ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN 会覆盖下面同名项。",

  "base_url": "https://api.anthropic.com",
  "api_key": "",
  "model": "claude-opus-4-5",

  "//可选": "以下键均可省略；省略即用默认（多数开关默认关）。",
  "permission": "auto",
  "skills_dir": "skills",
  "cwd": "",

  "retrieval": false,
  "memory": false,
  "persist": false,
  "sandbox": "host",
  "todo": false,
  "parallel_tools": false,
  "prompt_cache": false,
  "fallback_models": []
}
